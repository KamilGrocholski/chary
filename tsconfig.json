{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",

    // Every import is written from the repository root — a path reads the same wherever it
    // appears, and moving a file does not rewrite its neighbours' imports. AGENTS.md §9.3.
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Dead code is not to accumulate — NEVER_ONLINE_DAYS survived a format rebuild in
    // web/app.ts only because nobody was holding it.
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // An index into an array answers `T | undefined`, because it does. Three `!` in
    // trends.ts were covering for its absence, and each of them stood over a real
    // invariant that is now stated as one — see AGENTS.md §9.5.
    "noUncheckedIndexedAccess": true,

    "noPropertyAccessFromIndexSignature": false
  },

  // public/ holds no source any more: the dashboard is built into it from web/, and
  // everything else there is markup, data or somebody else's vendored library.
  "exclude": ["node_modules", "public"]
}
